APP_NAME=AL Torrent Tools
APP_ENV=dev
SECRET_KEY=change-me

DATABASE_URL=postgresql+psycopg://altt:altt@postgres:5432/altt

ANILIBRIA_BASE_URL=https://anilibria.top/api/v1
ANILIBRIA_FALLBACK_BASE_URL=https://anilibria.top/api/v1
ANILIBRIA_SITE_URL=https://www.anilibria.top
ANILIBRIA_BEARER_TOKEN=
# Passkey для announce (?pk=); обычно подтягивается после «Войти в API».
# ANILIBRIA_PASSKEY=
# Опционально: логин/пароль для POST /accounts/users/auth/login (токен сохраняется в БД).
# ANILIBRIA_LOGIN=
# ANILIBRIA_PASSWORD=
ANILIBRIA_REQUEST_RETRIES=3
ANILIBRIA_RETRY_DELAY_MS=750

SCRAPE_PAUSE_EVERY=10
SCRAPE_PAUSE_SEC=2
ONGOING_INTERVAL_SEC=120
CLEANUP_INTERVAL_SEC=3600
# false = cleanup только логирует кандидатов; true + dry_run=false = реальное удаление.
CLEANUP_ALLOW_DELETE=true
PIPELINE_MASTER_MIN_AGE_MIN=5
# Pending/running без активности (логи) дольше N минут → cancelled (reclaim).
JOB_STALE_MINUTES=30

# Каталог хранения .torrent (канон: TORRENT_STORAGE_DIR → settings.torrent_storage_dir).
# Docker Compose задаёт /app/data/torrents (+ volume ./data/torrents).
# Локально без env: <repo>/data/torrents.
# TORRENT_STORAGE_DIR=/app/data/torrents

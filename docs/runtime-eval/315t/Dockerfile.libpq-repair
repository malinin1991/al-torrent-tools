FROM altt-python-eval:315t-pure-20261013
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends libpq5; \
    rm -rf /var/lib/apt/lists/*; \
    python -c "import psycopg,sys; print(psycopg.pq.__impl__,psycopg.pq.version(),sys._is_gil_enabled()); assert psycopg.pq.__impl__ == 'python'"
